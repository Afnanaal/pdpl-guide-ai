# =====================================================================
# PDPL Guide AI - Environment Variables Template
# =====================================================================
# Copy this file to .env and insert your API key(s) if you wish to enable
# the Generative AI (LLM) mode.
# If no key is provided, the application runs in authentic Retrieval-Only mode.
# =====================================================================

# Google Gemini API Key (Recommended for Generative Mode)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Groq API Key
# GROQ_API_KEY=your_groq_api_key_here
